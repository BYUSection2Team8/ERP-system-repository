# Copy to .env for local development (only if Node.js is installed).
# On GitHub these come from repository secrets with the same names.
# Use the anon / publishable key only. NEVER the service_role key or the database password.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
# Optional (Phase 10): EmailJS sends the "Track your order" email. Without these the
# app still shows the tracking link + QR code and logs the email as "not sent".
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
